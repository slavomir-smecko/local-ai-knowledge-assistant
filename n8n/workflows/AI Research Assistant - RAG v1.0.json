      "parameters": {
        "jsCode": "// Get the original question from Webhook\nconst question = $('Webhook').first().json.body.question;\n\n// Get previous rows from Data Table\nconst rows = $input.all();\n\n// Prepare history\nconst history = rows.map(item => {\n  return {\n    question: item.json.question,\n    answer: item.json.answer,\n    sources: item.json.sources\n  };\n});\n\n// Return payload for FastAPI\nreturn [\n  {\n    json: {\n      question: question,\n      history: history\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -32,
        224
      ],
      "id": "18ff4999-6cbe-42a8-b761-9e5069ab58db",
      "name": "Prepare history"
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "3HdbS7092x9DSyou",
          "mode": "list",
          "cachedResultName": "chat_memory",
          "cachedResultUrl": "/projects/LPILM4i7RtuLsk0w/datatables/3HdbS7092x9DSyou"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "session_id",
              "keyValue": "={{ $('Validate Request').item.json.session_id }}"
            }
          ]
        },
        "limit": "=const MAX_CHARS = 8000;\n\nlet history = [];\n\nlet size = 0;\n\nfor (const row of items) {\n    const text = `${row.json.question}\\n${row.json.answer}\\n`;\n\n    if (size + text.length > MAX_CHARS) break;\n\n    history.push({\n        question: row.json.question,\n        answer: row.json.answer,\n    });\n\n    size += text.length;\n}\n\nreturn [{\n    json: {\n        history\n    }\n}];",
        "orderBy": true,
        "orderByColumn": "session_id"
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -256,
