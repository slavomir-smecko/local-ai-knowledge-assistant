      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const errorMessage =\n  $json.errorMessage ||\n  $json.message ||\n  \"Unknown storage error\";\n\nreturn [\n  {\n    json: {\n      timestamp: new Date().toISOString(),\n      component: \"execution_logging\",\n      status: \"error\",\n      error_message: errorMessage,\n      session_id: $json.session_id || \"unknown\",\n      question: $json.question || \"\",\n      latency_ms: $json.latency_ms || null\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -160
      ],
      "id": "79c91fa2-e7b5-4e22-8970-0276e3d27ef9",
      "name": "Format Storage Error Logs"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      status: \"warning\",\n      message: \"Answer generated but conversation memory could not be saved\",\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        416
      ],
      "id": "ab59f0fa-4e48-46ea-adf3-fa6e82857fb8",
      "name": "Format Storage Error Memory"
    },
    {
      "parameters": {
        "jsCode": "const metadata = items.find(item => item.json.execution_id);\nconst logs = items.filter(item => item.json.component);\n\nconst getStatus = (component) =>\n  logs.find(l => l.json.component === component)?.json.status ?? null;\n\nconst errorMessages = logs\n  .map(l => l.json.error_message)\n  .filter(Boolean)\n  .join(\"; \");\n\nreturn [\n  {\n    json: {\n      session_id: metadata?.json.session_id ?? null,\n      execution_id: metadata?.json.execution_id ?? null,\n\n      webhook: getStatus(\"webhook\"),\n      validation: getStatus(\"validation\"),\n      rag_api: getStatus(\"rag-api\"),\n      memory_table_insertion: getStatus(\"memory table insertion\"),\n\n      error_message: errorMessages || null,\n\n      latency_ms: metadata?.json.latency_ms ?? null,\n\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        -160
      ],
